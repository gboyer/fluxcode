      "source_url": "https://engineering.case.edu/bearingdatacenter",
      "license": "Public academic research (CWRU); NumPy mirror MIT",
      "citation": "Case Western Reserve University Bearing Data Center (1730 RPM, 12 kHz & 48 kHz); packaged by srigas/CWRU_Bearing_NumPy.",
      "sampling": "12 kHz & 48 kHz mechanical accelerometer waveforms (normal, inner-race fault, ball fault; hidden ADC calibration step)."
    },
    "MIT-BIH ECG": {
      "source": "PhysioNet MIT-BIH Arrhythmia Database (records 100, 101)",
      "source_url": "https://physionet.org/content/mitdb/1.0.0/",
      "license": "ODC-By 1.0",
      "citation": "Moody GB, Mark RG (2001). The impact of the MIT-BIH Arrhythmia Database. IEEE Eng in Med and Biol 20(3):45-50. PhysioNet.",
      "sampling": "360 Hz 2-channel ECG (650k samples/ch), 11-bit ADC scaled to mV (0.005 mV scaled decimal grid)."
    },
    "IRIS Seismic": {
      "source": "IRIS/EarthScope FDSN (IU.ANMO.00.BHZ/BH1, 2023-02-06 M7.8 earthquake)",
      "source_url": "https://service.iris.edu/fdsnws/dataselect/1/",
      "license": "CC0 1.0 / Public Domain (GSN/USGS/EarthScope)",
      "citation": "Albuquerque Seismological Laboratory (ASL)/USGS (1988). Global Seismograph Network (GSN - IRIS/USGS), Network IU, Station ANMO.",
      "sampling": "40 Hz 24-bit sigma-delta broadband seismometer (288k samples/ch, steep anti-alias filter; raw counts & calibrated m/s velocity)."
    },
    "BIDMC Clinical": {
      "source": "PhysioNet BIDMC PPG and Respiration Dataset (record 01)",
      "source_url": "https://physionet.org/content/bidmc/1.0.0/",
      "license": "ODC-By 1.0",
      "citation": "Pimentel MAF et al. (2016). Toward a Robust Estimation of Respiratory Rate From Pulse Oximeters. IEEE TBME. PhysioNet BIDMC v1.0.0.",
      "sampling": "125 Hz clinical monitor (60k samples/ch: RESP, PLETH, ECG II & V)."
    },
    "UCI Power": {
      "source": "UCI Individual Household Electric Power Consumption",
      "source_url": "https://archive.ics.uci.edu/dataset/235",
      "license": "CC BY 4.0",
      "citation": "Hebrail G, Berard A (2006). Individual Household Electric Power Consumption. UCI Machine Learning Repository.",
      "sampling": "1-min smart-meter telemetry (~2.08M rows x 7 ch), exact timestamps + ~1.3% NaN gaps."
    },
    "UCI Hydraulic": {
      "source": "UCI Condition Monitoring of Hydraulic Systems",
      "source_url": "https://archive.ics.uci.edu/dataset/447",
      "license": "CC BY 4.0",
      "citation": "Helwig N, Pignanelli E, Schütze A (2018). Condition Monitoring of Hydraulic Systems. UCI Machine Learning Repository.",
      "sampling": "Multi-rate industrial hydraulic PLC/DAQ (100 Hz pressure/motor power, 10 Hz flow, 1 Hz temp/vibration)."
    },
    "SKAB Industrial": {
      "source": "Skoltech Anomaly Benchmark (SKAB)",
      "source_url": "https://github.com/waico/SKAB",
      "license": "CC BY-SA 4.0 (data) / GPL-3.0 (code)",
      "citation": "Katser ID, Kozitsin VO (2020). Skoltech Anomaly Benchmark (SKAB). GitHub waico/SKAB.",
      "sampling": "1 Hz industrial water-circulation plant PLC sensors (7 channels) with timestamps."
    },
    "UCI AirQuality": {
      "source": "UCI Air Quality",
      "source_url": "https://archive.ics.uci.edu/dataset/360",
      "license": "CC BY 4.0",
      "citation": "Vito S (2008). Air Quality. UCI Machine Learning Repository.",
      "sampling": "Hourly chemical sensor array (9,357 rows), exact timestamps + -200 error-code glitches."
    },
    "UCI Appliances": {
      "source": "UCI Appliances Energy Prediction",
      "source_url": "https://archive.ics.uci.edu/dataset/374",
      "license": "CC BY 4.0",
      "citation": "Candanedo L (2017). Appliances Energy Prediction. UCI Machine Learning Repository.",
      "sampling": "10-min indoor/outdoor temp & humidity sensors (averaged 1/3, 1/4 rational grids) + rv1 uniform random noise."
    },
    "NOAA Buoy": {
      "source": "NOAA NDBC Station 46026 (San Francisco, 2023)",
      "source_url": "https://www.ndbc.noaa.gov/station_page.php?station=46026",
      "license": "Public Domain (U.S. Government / NOAA)",
      "citation": "NOAA National Data Buoy Center (NDBC), Station 46026, 2023 Standard Meteorological Data.",
      "sampling": "10-min ocean buoy telemetry with gaps & 99/999 sentinels (tested raw and sentinels -> NaN)."
    },
    "ERA5 Weather": {
      "source": "Open-Meteo ERA5 Reanalysis (San Francisco 2023, hourly)",
      "source_url": "https://open-meteo.com/en/docs/historical-weather-api",
      "license": "CC BY 4.0 (Open-Meteo) / Copernicus C3S License (ERA5)",
      "citation": "Hersbach H et al. (2020). ERA5 Reanalysis via Open-Meteo Historical Weather API (San Francisco 2023 hourly).",
      "sampling": "Hourly weather fields (8,760 rows), tested both as-parsed decimal and float32-promoted-to-float64 (*_f32)."
    },
    "Binance Trades": {
      "source": "Binance Public Data Vision (BTCUSDT-trades-2024-01-01)",
      "source_url": "https://data.binance.vision/",
      "license": "Binance Public Market Data",
      "citation": "Binance Public Data Vision, Spot Daily Trades BTCUSDT (2024-01-01).",
      "sampling": "1.11M high-frequency exchange trades with irregular millisecond arrival timestamps, decimal prices, and quantities."
    },
    "Smartphone IMU": {
      "source": "AZI350 Smartphone IMU Three Positions Dataset (walking & running)",
      "source_url": "https://github.com/AZI350/Smartphone-IMU-Three-Positions-Dataset",
      "license": "MIT",
      "citation": "AZI350. Smartphone IMU Three Positions Dataset (participant_001, hand walking/running trial_01).",
      "sampling": "3-axis accelerometer & gyroscope on a real jittered ~50 Hz millisecond smartphone clock (dt 16-177 ms)."
    },
    "Elf Corpus": {
      "source": "Spatio-Temporal-Lab/Elf (ElfTestData)",
      "source_url": "https://github.com/Spatio-Temporal-Lab/Elf",
      "license": "Apache-2.0 (repository); public benchmark corpus",
      "citation": "Li R et al. (2023). Elf: Erasing-based Lossless Floating-Point Compression. PVLDB 16(7):1763-1776.",
      "sampling": "18 standard VLDB/SIGMOD float-compression benchmark columns (weather, air sensors, GPS/POI, stocks, crypto, dust)."
    }
